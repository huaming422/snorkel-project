diff --git a/scripts/repro_unstable_pagination.go b/scripts/repro_unstable_pagination.go
new file mode 100644
index 00000000..46c06170
--- /dev/null
+++ b/scripts/repro_unstable_pagination.go
@@ -0,0 +1,125 @@
+// Reproduction of unstable LIMIT/OFFSET pagination when ORDER BY is not unique.
+//
+// Issue ids are unique per project only (PRIMARY KEY (project, id)). Ordering
+// cross-project lists by id alone leaves ties; walking pages with OFFSET then
+// drops and repeats rows once a page boundary splits a tied group. Adding the
+// rest of the primary key as a tiebreaker makes the order total and pages
+// stable.
+//
+// Run: go run ./scripts/repro_unstable_pagination.go
+package main
+
+import (
+	"fmt"
+	"os"
+	"sort"
+)
+
+type issue struct {
+	project string
+	id      int
+}
+
+func page(rows []issue, limit, offset int) []issue {
+	if offset >= len(rows) {
+		return nil
+	}
+	end := offset + limit
+	if end > len(rows) {
+		end = len(rows)
+	}
+	out := make([]issue, end-offset)
+	copy(out, rows[offset:end])
+	return out
+}
+
+// sortByID sorts by id DESC. When reverseTies is set, tied projects flip —
+// the same non-determinism PostgreSQL is free to use when ORDER BY is not unique.
+func sortByID(rows []issue, reverseTies bool) []issue {
+	out := append([]issue(nil), rows...)
+	sort.SliceStable(out, func(i, j int) bool {
+		if out[i].id != out[j].id {
+			return out[i].id > out[j].id
+		}
+		if reverseTies {
+			return out[i].project > out[j].project
+		}
+		return out[i].project < out[j].project
+	})
+	return out
+}
+
+func sortStable(rows []issue) []issue {
+	out := append([]issue(nil), rows...)
+	sort.SliceStable(out, func(i, j int) bool {
+		if out[i].id != out[j].id {
+			return out[i].id > out[j].id
+		}
+		return out[i].project < out[j].project
+	})
+	return out
+}
+
+func keyOf(r issue) string { return fmt.Sprintf("%s#%d", r.project, r.id) }
+
+// walkPages re-fetches and re-sorts on every page, like independent SQL queries.
+func walkPages(label string, sortFn func(int, []issue) []issue, all []issue, pageSize int) map[string]int {
+	seen := map[string]int{}
+	for offset, pageNum := 0, 0; offset < len(all); offset, pageNum = offset+pageSize, pageNum+1 {
+		ordered := sortFn(pageNum, all)
+		chunk := page(ordered, pageSize, offset)
+		fmt.Printf("  %s page %d (offset %d):", label, pageNum, offset)
+		for _, r := range chunk {
+			seen[keyOf(r)]++
+			fmt.Printf(" %s", keyOf(r))
+		}
+		fmt.Println()
+	}
+	return seen
+}
+
+func exactOnce(all []issue, seen map[string]int) bool {
+	if len(seen) != len(all) {
+		return false
+	}
+	for _, r := range all {
+		if seen[keyOf(r)] != 1 {
+			return false
+		}
+	}
+	return true
+}
+
+func main() {
+	// Three projects × ids 1..3. Page size 4 splits tied id-groups across pages.
+	all := []issue{
+		{"alpha", 3}, {"beta", 3}, {"gamma", 3},
+		{"alpha", 2}, {"beta", 2}, {"gamma", 2},
+		{"alpha", 1}, {"beta", 1}, {"gamma", 1},
+	}
+	pageSize := 4
+
+	fmt.Println("UNSTABLE — ORDER BY id DESC only; tie direction flips each page:")
+	unstableSeen := walkPages("broken", func(pageNum int, rows []issue) []issue {
+		return sortByID(rows, pageNum%2 == 1)
+	}, all, pageSize)
+	unstableOK := exactOnce(all, unstableSeen)
+	fmt.Printf("  counts=%v exact-once=%v\n\n", unstableSeen, unstableOK)
+
+	fmt.Println("STABLE — ORDER BY id DESC, project ASC:")
+	stableSeen := walkPages("fixed", func(_ int, rows []issue) []issue {
+		return sortStable(rows)
+	}, all, pageSize)
+	stableOK := exactOnce(all, stableSeen)
+	fmt.Printf("  counts=%v exact-once=%v\n\n", stableSeen, stableOK)
+
+	if unstableOK {
+		fmt.Println("FAIL: expected unstable walk to drop/duplicate rows")
+		os.Exit(1)
+	}
+	if !stableOK {
+		fmt.Println("FAIL: stable walk must return every row exactly once")
+		os.Exit(1)
+	}
+	fmt.Println("repro ok: unstable drops/duplicates; stable is exact-once")
+}
