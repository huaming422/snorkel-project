 }
+
+func TestStableOrderBy(t *testing.T) {
+	// Issue ids are only unique per project. Without project as a
+	// tiebreaker, cross-project LIMIT/OFFSET pages are non-deterministic.
+	issueTiebreakers := []*OrderByKey{
+		{Key: "issue.id", SortOrder: DESC},
+		{Key: "issue.project", SortOrder: ASC},
+	}
+
+	t.Run("default most-recent-first", func(t *testing.T) {
+		got := stableOrderBy(nil, issueTiebreakers...)
+		require.Equal(t, "ORDER BY issue.id DESC, issue.project ASC", got)
+	})
+
+	t.Run("caller order_by with unique tiebreakers", func(t *testing.T) {
+		got := stableOrderBy(
+			[]*OrderByKey{{Key: "issue.updated_at", SortOrder: DESC}},
+			issueTiebreakers...,
+		)
+		require.Equal(t, "ORDER BY issue.updated_at DESC, issue.id DESC, issue.project ASC", got)
+	})
+
+	t.Run("search relevance keeps unique tiebreakers", func(t *testing.T) {
+		got := stableOrderBy(
+			[]*OrderByKey{{Key: "ts_rank(issue.ts_vector, query)", SortOrder: DESC}},
+			issueTiebreakers...,
+		)
+		require.Equal(t, "ORDER BY ts_rank(issue.ts_vector, query) DESC, issue.id DESC, issue.project ASC", got)
+	})
+
+	t.Run("skips tiebreaker already present in keys", func(t *testing.T) {
+		got := stableOrderBy(
+			[]*OrderByKey{{Key: "issue.id", SortOrder: ASC}},
+			issueTiebreakers...,
+		)
+		// id already requested (ASC); project still appended for uniqueness.
+		require.Equal(t, "ORDER BY issue.id ASC, issue.project ASC", got)
+	})
+
+	t.Run("plan composite primary key", func(t *testing.T) {
+		got := stableOrderBy(nil,
+			&OrderByKey{Key: "id", SortOrder: DESC},
+			&OrderByKey{Key: "project", SortOrder: ASC},
+		)
+		require.Equal(t, "ORDER BY id DESC, project ASC", got)
+	})
+}
