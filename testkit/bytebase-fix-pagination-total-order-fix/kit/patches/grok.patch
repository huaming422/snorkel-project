index 9163e3ce..f5ab9542 100644
--- a/backend/store/common.go
+++ b/backend/store/common.go
@@ -1,6 +1,7 @@
 package store
 
 import (
+	"fmt"
 	"regexp"
 	"strings"
 
@@ -36,6 +37,32 @@ type OrderByKey struct {
 	SortOrder SortOrder
 }
 
+// stableOrderBy builds an ORDER BY clause from the requested sort keys and a
+// set of unique tiebreaker columns. LIMIT/OFFSET pagination is only stable
+// when the full ORDER BY uniquely identifies every row: without the
+// tiebreakers, rows that share the same sort values can swap places between
+// pages, producing duplicates and gaps. Tiebreakers already present in keys
+// are skipped. When keys is empty, the tiebreakers alone form the default
+// order.
+func stableOrderBy(keys []*OrderByKey, tiebreakers ...*OrderByKey) string {
+	parts := make([]string, 0, len(keys)+len(tiebreakers))
+	seen := make(map[string]bool, len(keys)+len(tiebreakers))
+	appendKey := func(k *OrderByKey) {
+		if k == nil || k.Key == "" || seen[k.Key] {
+			return
+		}
+		parts = append(parts, fmt.Sprintf("%s %s", k.Key, k.SortOrder.String()))
+		seen[k.Key] = true
+	}
+	for _, k := range keys {
+		appendKey(k)
+	}
+	for _, k := range tiebreakers {
+		appendKey(k)
+	}
+	return "ORDER BY " + strings.Join(parts, ", ")
+}
+
 // getOrderByKeys parses an AIP-132 order_by string against a whitelist
 // mapping API field names to SQL columns. Strict where parseOrderBy is not:
 // every comma-separated entry must be a whitelisted field with an optional
