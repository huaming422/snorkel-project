+func TestPaginateConvertedIssuesWithPostFilter(t *testing.T) {
+	raw := []*store.IssueMessage{
+		{ProjectID: "project-a", UID: 4},
+		{ProjectID: "project-a", UID: 3},
+		{ProjectID: "project-a", UID: 2},
+		{ProjectID: "project-a", UID: 1},
+	}
+	fetch := func(limit, offset int) ([]*store.IssueMessage, error) {
+		if offset >= len(raw) {
+			return nil, nil
+		}
+		end := offset + limit
+		if end > len(raw) {
+			end = len(raw)
+		}
+		return raw[offset:end], nil
+	}
+	convert := func(issues []*store.IssueMessage) ([]*v1pb.Issue, error) {
+		var out []*v1pb.Issue
+		for _, issue := range issues {
+			if issue.UID%2 == 1 {
+				continue
+			}
+			out = append(out, &v1pb.Issue{Name: common.FormatIssue(issue.ProjectID, issue.UID)})
+		}
+		return out, nil
+	}
+
+	firstPage, nextPageToken, err := paginateConvertedIssues(&pageOffset{limit: 1, offset: 0}, true, fetch, convert)
+	require.NoError(t, err)
+	require.Equal(t, []*v1pb.Issue{{Name: "projects/project-a/issues/4"}}, firstPage)
+	require.NotEmpty(t, nextPageToken)
+
+	secondPage, nextPageToken, err := paginateConvertedIssues(&pageOffset{limit: 1, offset: 1}, true, fetch, convert)
+	require.NoError(t, err)
+	require.Equal(t, []*v1pb.Issue{{Name: "projects/project-a/issues/2"}}, secondPage)
+	require.Empty(t, nextPageToken)
+}
