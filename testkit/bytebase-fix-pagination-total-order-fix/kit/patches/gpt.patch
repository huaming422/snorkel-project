+func (f *filterIssueMessage) requiresPostFilter() bool {
+	return f != nil && (f.ApprovalStatus != nil || f.Approver != nil)
+}
+
+func paginateConvertedIssues(
+	page *pageOffset,
+	requiresPostFilter bool,
+	fetch func(limit, offset int) ([]*store.IssueMessage, error),
+	convert func([]*store.IssueMessage) ([]*v1pb.Issue, error),
+) ([]*v1pb.Issue, string, error) {
+	if !requiresPostFilter {
+		limitPlusOne := page.limit + 1
+		issues, err := fetch(limitPlusOne, page.offset)
+		if err != nil {
+			return nil, "", err
+		}
+		converted, err := convert(issues)
+		if err != nil {
+			return nil, "", err
+		}
+		if len(converted) <= page.limit {
+			return converted, "", nil
+		}
+		nextPageToken, err := page.getNextPageToken()
+		if err != nil {
+			return nil, "", err
+		}
+		return converted[:page.limit], nextPageToken, nil
+	}
+
+	batchSize := page.limit + 1
+	if batchSize < 100 {
+		batchSize = 100
+	}
+	skipped := 0
+	rawOffset := 0
+	convertedPage := make([]*v1pb.Issue, 0, page.limit+1)
+	for {
+		issues, err := fetch(batchSize, rawOffset)
+		if err != nil {
+			return nil, "", err
+		}
+		if len(issues) == 0 {
+			break
+		}
+
+		converted, err := convert(issues)
+		if err != nil {
+			return nil, "", err
+		}
+		for _, issue := range converted {
+			if skipped < page.offset {
+				skipped++
+				continue
+			}
+			convertedPage = append(convertedPage, issue)
+			if len(convertedPage) == page.limit+1 {
+				nextPageToken, err := page.getNextPageToken()
+				if err != nil {
+					return nil, "", err
+				}
+				return convertedPage[:page.limit], nextPageToken, nil
+			}
+		}
+		if len(issues) < batchSize {
+			break
+		}
+		rawOffset += len(issues)
+	}
+	return convertedPage, "", nil
+}
+
+func (s *IssueService) listPagedIssues(ctx context.Context, find *store.FindIssueMessage, issueFilter *filterIssueMessage, page *pageOffset) ([]*v1pb.Issue, string, error) {
+	return paginateConvertedIssues(
+		page,
+		issueFilter.requiresPostFilter(),
+		func(limit, offset int) ([]*store.IssueMessage, error) {
+			queryFind := *find
+			queryFind.Limit = &limit
+			queryFind.Offset = &offset
+			return s.store.ListIssues(ctx, &queryFind)
+		},
+		func(issues []*store.IssueMessage) ([]*v1pb.Issue, error) {
+			return s.convertToIssues(ctx, issues, issueFilter)
+		},
+	)
+}
