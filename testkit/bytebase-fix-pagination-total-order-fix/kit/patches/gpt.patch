+func TestBuildStableOrderByClause(t *testing.T) {
+	t.Run("default order plus explicit tiebreak", func(t *testing.T) {
+		got := buildStableOrderByClause(nil, []*OrderByKey{{Key: "created_at", SortOrder: DESC}}, []*OrderByKey{{Key: "id"}})
+		require.Equal(t, "ORDER BY created_at DESC, id DESC", got)
+	})
+
+	t.Run("requested order inherits final direction for tiebreak", func(t *testing.T) {
+		got := buildStableOrderByClause([]*OrderByKey{{Key: "name", SortOrder: ASC}}, nil, []*OrderByKey{{Key: "resource_id"}})
+		require.Equal(t, "ORDER BY name ASC, resource_id ASC", got)
+	})
+
+	t.Run("existing tiebreak key is not duplicated", func(t *testing.T) {
+		got := buildStableOrderByClause([]*OrderByKey{{Key: "resource_id", SortOrder: DESC}}, nil, []*OrderByKey{{Key: "resource_id"}})
+		require.Equal(t, "ORDER BY resource_id DESC", got)
+	})
+}
