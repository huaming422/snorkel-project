 	return result, nil
 }
+
+// buildStableOrderByClause builds an ORDER BY clause and appends hidden
+// tiebreak keys so OFFSET-based pagination stays stable even when the visible
+// sort keys are not unique. A tiebreak key with an empty SortOrder inherits the
+// final explicit sort direction from the primary keys (or ASC if none exist).
+func buildStableOrderByClause(keys, defaultKeys, tieBreakers []*OrderByKey) string {
+	orderKeys := keys
+	if len(orderKeys) == 0 {
+		orderKeys = defaultKeys
+	}
+	if len(orderKeys) == 0 && len(tieBreakers) == 0 {
+		return ""
+	}
+
+	parts := make([]string, 0, len(orderKeys)+len(tieBreakers))
+	seen := make(map[string]bool, len(orderKeys))
+	lastSortOrder := ASC
+	for _, key := range orderKeys {
+		parts = append(parts, fmt.Sprintf("%s %s", key.Key, key.SortOrder.String()))
+		seen[key.Key] = true
+		if key.SortOrder != "" {
+			lastSortOrder = key.SortOrder
+		}
+	}
+	for _, key := range tieBreakers {
+		if seen[key.Key] {
+			continue
+		}
+		sortOrder := key.SortOrder
+		if sortOrder == "" {
+			sortOrder = lastSortOrder
+		}
+		parts = append(parts, fmt.Sprintf("%s %s", key.Key, sortOrder.String()))
+	}
+	return fmt.Sprintf("ORDER BY %s", strings.Join(parts, ", "))
+}
