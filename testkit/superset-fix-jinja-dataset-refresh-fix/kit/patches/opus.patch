+# Jinja delimiters. If any of these appear in a SQL string, the SQL is
+# templated and cannot be reliably parsed/validated until it is rendered with
+# the appropriate (query-time) template parameters.
+JINJA_DELIMITERS = ("{{", "{%", "{#")
+
+
+def has_jinja(sql: Optional[str]) -> bool:
+    """
+    Return ``True`` if the SQL string contains Jinja templating markers.
+
+    Templated SQL often renders to invalid SQL when evaluated without the
+    runtime template parameters (e.g. ``WHERE col = {% if x %}1{% endif %}``
+    renders to ``WHERE col = `` when ``x`` is falsy). Callers that parse SQL at
+    save/validation time should use this to avoid surfacing spurious
+    "Invalid SQL" errors for SQL that is perfectly valid once rendered.
+    """
+    if not sql:
+        return False
+    return any(delimiter in sql for delimiter in JINJA_DELIMITERS)
+
+
