+def test_has_jinja() -> None:
+    """
+    ``has_jinja`` detects Jinja templating markers so templated SQL can be
+    exempted from parse-time "Invalid SQL" validation.
+    """
+    assert has_jinja("SELECT * FROM my_table WHERE col = {% if x %}1{% endif %}")
+    assert has_jinja("SELECT {{ some_value }} FROM my_table")
+    assert has_jinja("SELECT 1 {# a comment #}")
+    assert not has_jinja("SELECT * FROM my_table")
+    assert not has_jinja("")
+    assert not has_jinja(None)
