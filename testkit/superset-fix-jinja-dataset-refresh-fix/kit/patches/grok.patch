+def test_create_dataset_jinja_sql_parse_error_is_not_blocking() -> None:
+    """Jinja virtual SQL that cannot be parsed unrendered must not raise Invalid SQL."""
+    mock_database = Mock(spec=Database)
+    mock_database.id = 1
+    mock_database.db_engine_spec.engine = "postgresql"
+    mock_database.get_default_catalog.return_value = None
+
+    jinja_sql = (
+        "SELECT * FROM t WHERE 1=1 "
+        "{% if filter_values('status') %} AND status = 1 {% endif %}"
+    )
+
+    with patch(
+        "superset.commands.dataset.create.DatasetDAO.get_database_by_id",
+        return_value=mock_database,
+    ):
+        with patch(
+            "superset.commands.dataset.create.DatasetDAO.validate_uniqueness",
+            return_value=True,
+        ):
+            with patch(
+                "superset.commands.dataset.create.security_manager.raise_for_access",
+                side_effect=SupersetParseError(
+                    sql=jinja_sql,
+                    engine="postgresql",
+                    message="Error parsing near '{%' at line 1:28",
+                ),
+            ):
+                with patch(
+                    "superset.commands.dataset.create.populate_subjects",
+                    return_value=[],
+                ):
+                    command = CreateDatasetCommand(
+                        {
+                            "database": 1,
+                            "table_name": "jinja_virtual",
+                            "sql": jinja_sql,
+                        }
+                    )
+                    # Should not raise DatasetInvalidError
+                    command.validate()
+
+
+def test_create_dataset_plain_invalid_sql_still_errors() -> None:
+    """Plain (non-Jinja) unparseable SQL must still surface Invalid SQL."""
+    mock_database = Mock(spec=Database)
+    mock_database.id = 1
+    mock_database.db_engine_spec.engine = "postgresql"
+    mock_database.get_default_catalog.return_value = None
+
+    with patch(
+        "superset.commands.dataset.create.DatasetDAO.get_database_by_id",
+        return_value=mock_database,
+    ):
+        with patch(
+            "superset.commands.dataset.create.DatasetDAO.validate_uniqueness",
+            return_value=True,
+        ):
+            with patch(
+                "superset.commands.dataset.create.security_manager.raise_for_access",
+                side_effect=SupersetParseError(
+                    sql="SELECT INVALID",
+                    engine="postgresql",
+                    message="Invalid SQL syntax",
+                ),
+            ):
+                with patch(
+                    "superset.commands.dataset.create.populate_subjects",
+                    return_value=[],
+                ):
+                    command = CreateDatasetCommand(
+                        {
+                            "database": 1,
+                            "table_name": "bad_sql",
+                            "sql": "SELECT INVALID",
+                        }
+                    )
+                    with pytest.raises(DatasetInvalidError) as exc_info:
+                        command.validate()
+                    assert any(
+                        "Invalid SQL:" in str(err.messages[0])
+                        for err in exc_info.value._exceptions
+                    )
