+#!/usr/bin/env bash
+set -euo pipefail
+
+cd /repo/superset
+
+echo "Running backend regression for partial-success dataset save with failed column sync..."
+pytest -q tests/unit_tests/datasets/api_tests.py -k "refresh_failure_returns_partial_success"
+
+if command -v npm >/dev/null 2>&1; then
+  echo "Running frontend regression for datasource modal warning behavior..."
+  npm --prefix superset-frontend test -- --runInBand --watch=false src/components/Datasource/DatasourceModal/DatasourceModal.test.tsx -t "warning instead of a save error"
+else
+  echo "npm not available; running static frontend assertions instead..."
+  python - <<'PY'
+from pathlib import Path
+
+modal = Path('superset-frontend/src/components/Datasource/DatasourceModal/index.tsx').read_text()
+types = Path('superset-frontend/src/components/Datasource/types.ts').read_text()
+tests = Path('superset-frontend/src/components/Datasource/DatasourceModal/DatasourceModal.test.tsx').read_text()
+
+assert 'column_sync_error' in modal
+assert 'The dataset was saved, but columns could not be synced: %s' in modal
+assert 'The dataset was saved, but the latest metadata could not be reloaded.' in modal
+assert 'addWarningToast' in types
+assert 'shows a warning instead of a save error when column sync fails after save' in tests
+assert 'shows a warning instead of a save error when the post-save reload fails' in tests
+print('Static frontend assertions passed.')
+PY
+fi
