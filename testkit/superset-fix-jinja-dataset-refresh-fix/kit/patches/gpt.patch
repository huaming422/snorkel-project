+def test_put_dataset_override_columns_refresh_failure_returns_partial_success(
+    session: Session,
+    client: Any,
+    full_api_access: None,
+) -> None:
+    """
+    A failed post-save refresh should not turn a successful dataset update into
+    a save error response.
+    """
+    from superset.connectors.sqla.models import SqlaTable
+    from superset.models.core import Database
+
+    SqlaTable.metadata.create_all(db.session.get_bind())
+
+    database = Database(
+        database_name="my_db_refresh_failure",
+        sqlalchemy_uri="sqlite://",
+    )
+    dataset = SqlaTable(
+        table_name="test_put_refresh_failure_dataset",
+        database=database,
+        description="before",
+    )
+    db.session.add(dataset)
+    db.session.flush()
+
+    with patch(
+        "superset.commands.dataset.update.security_manager.raise_for_editorship"
+    ), patch(
+        "superset.commands.dataset.update.compute_subjects"
+    ), patch(
+        "superset.datasets.api.RefreshDatasetCommand.run",
+        side_effect=SupersetGenericDBErrorException(
+            message="Invalid SQL: unexpected EOF"
+        ),
+    ):
+        response = client.put(
+            f"/api/v1/dataset/{dataset.id}?override_columns=true",
+            json={"description": "after"},
+        )
+
+    assert response.status_code == 200
+    assert response.json["column_sync_error"] == "Invalid SQL: unexpected EOF"
+
+    db.session.refresh(dataset)
+    assert dataset.description == "after"
