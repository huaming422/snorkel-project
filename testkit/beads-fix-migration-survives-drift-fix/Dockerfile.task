# Task image for gastownhall/beads, derived from the repo environment
# Dockerfile (manifest env_ref 7c2dd72e...), per AUTHORING.md §1.2
# "Deriving the task Dockerfile":
#   - block 6 ARG REPO_SHA pinned to manifest.pre_fix_sha (step 1)
#   - no toolchain ARG bump: GO_VERSION is the environment default and go.mod
#     did not move its directive between the env authoring SHA and the base
#     (step 2)
#   - no 5b dependency warm: the task needs no new module, so go.mod and
#     go.sum stay as they are at the base (step 3)
#   - go build-cache purge before block 7 (step 5): the seed block compiled
#     repository code at a commit newer than this task's base, so its go-build
#     cache could hold the fix; the module cache (third-party) stays
FROM ubuntu:22.04
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8 LC_ALL=C.UTF-8

# 0. Moving parts.
# Go: environment default
ARG GO_VERSION=1.26.10

# 1. OS packages.
# git-core PPA supplies a git new enough for `git worktree list --porcelain -z`
# (needs >= 2.36; jammy ships 2.34). Pin the exact PPA build for reproducibility.
ARG GIT_VERSION=1:2.56.0-0ppa1~ubuntu22.04.2
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl build-essential jq libicu-dev lsof \
        software-properties-common gpg-agent \
    && add-apt-repository -y ppa:git-core/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends "git=${GIT_VERSION}" \
    && git --version \
    && rm -rf /var/lib/apt/lists/*

# 2. Verifier stack: isolated under /opt/tooling and off PATH.
# Canonical verifier runtime. Insert after apt/system packages and
# before the repository language toolchain so same-repo images share the layer.
# The pins are src/resources/verifier-requirements.txt inlined. BUILD_DATE
# freezes their transitive resolution (UV_EXCLUDE_NEWER, this install only); it
# may move forward per image but never before the newest pin's release. uv
# counts the whole named day, so use a day that has already ended. The ARG may
# instead sit with the image's other ARGs at the top of the final stage.
ARG BUILD_DATE=2026-10-23
RUN curl -LsSf https://astral.sh/uv/0.11.26/install.sh | env UV_INSTALL_DIR=/opt/tooling/uv UV_NO_MODIFY_PATH=1 sh \
 && export UV_PYTHON_INSTALL_DIR=/opt/tooling/python UV_NO_CACHE=1 \
 && /opt/tooling/uv/uv python install 3.12 \
 && /opt/tooling/uv/uv venv --managed-python --python 3.12 /opt/tooling/venv \
 && UV_EXCLUDE_NEWER=${BUILD_DATE} /opt/tooling/uv/uv pip install --python /opt/tooling/venv/bin/python \
    pytest==9.1.1 requests==2.34.2 jinja2==3.1.6 litellm==1.93.0 pydantic==2.13.4 \
    unidiff==0.7.5 pygments==2.20.0 ast-grep-py==0.44.1 mini-swe-agent==2.4.5 portkey-ai==2.3.3 \
 && LITELLM_LOCAL_MODEL_COST_MAP=True /opt/tooling/venv/bin/python -c "import ast_grep_py, jinja2, litellm, minisweagent, portkey_ai, pydantic, pygments, pytest, requests, unidiff"

# 3. Go toolchain: exact per-architecture archive and published checksum.
RUN ARCH="$(dpkg --print-architecture)" && case "$ARCH" in \
      amd64|arm64) URL="https://dl.google.com/go/go${GO_VERSION}.linux-${ARCH}.tar.gz";; \
      *) echo "unsupported arch $ARCH" >&2; exit 1;; esac \
    && curl -fsSL -o /tmp/go.tgz "$URL" \
    && curl -fsSL "${URL}.sha256" | sed "s|$|  /tmp/go.tgz|" | sha256sum -c - \
    && tar -C /usr/local -xzf /tmp/go.tgz && rm /tmp/go.tgz \
    && /usr/local/go/bin/go version
ENV PATH=/usr/local/go/bin:/root/go/bin:${PATH} GOPATH=/root/go GOMODCACHE=/opt/cache/go GOCACHE=/opt/cache/go-build GOTOOLCHAIN=local GOFLAGS=-mod=mod CGO_ENABLED=1

# 4. Parallelism caps: only tools detected in this repository.
# caps-skip: TURBO_CONCURRENCY, VITEST_MAX_THREADS, VITEST_MIN_THREADS, CARGO_BUILD_JOBS, RUST_TEST_THREADS, PYTEST_XDIST_AUTO_NUM_WORKERS, CMAKE_BUILD_PARALLEL_LEVEL (no JS/Rust/Python/CMake build in this Go repo)
ENV GOMAXPROCS=4 \
    OMP_THREAD_LIMIT=4
# Never MAKEFLAGS.

# 5. Module and build-cache warm from the literal authoring commit.
RUN git clone --depth=1 --single-branch --no-tags -b main https://github.com/gastownhall/beads.git /tmp/seed-src \
    && cd /tmp/seed-src \
    && git fetch --depth=1 origin 882317770349f3c2f61e603b5c1e74030354c955 \
    && git checkout --detach 882317770349f3c2f61e603b5c1e74030354c955 \
    && { go mod download all > /tmp/seed-go.log 2>&1 \
         && go build ./... >> /tmp/seed-go.log 2>&1 \
         && go test -count=1 -run '^$' ./... >> /tmp/seed-go.log 2>&1 \
         || { tail -50 /tmp/seed-go.log >&2; exit 1; }; } \
    && cd / && rm -rf /tmp/seed-src

# 5b. Purge what the caches built from the repository's own code (AUTHORING.md
# §1.2 step 5). Block 5 compiled beads at 882317..., which is newer than this
# task's base, so its go-build cache could embed the fix; drop it. The module
# cache (GOMODCACHE, third-party only) stays, so block 7 recompiles the base
# offline.
RUN go clean -cache

# 6. Clone, pin, scrub, baseline.
ARG REPO_BRANCH=main
ARG REPO_SHA=d5494cf8b6129f3c8519136f0267c86d6d3661ce
RUN git clone --single-branch --no-tags --branch "${REPO_BRANCH}" https://github.com/gastownhall/beads.git /repo/beads \
 && cd /repo/beads \
 && git fetch --depth=1000 origin ${REPO_SHA} \
 && git reset --hard ${REPO_SHA} \
 && git remote remove origin && rm -rf .git/refs/remotes \
 && rm -f .git/FETCH_HEAD .git/ORIG_HEAD .git/packed-refs \
 && printf '%s\n' "${REPO_SHA}" > /var/lib/repo_expected_sha \
 && git add -A \
 && if ! git diff --cached --quiet; then git -c user.email=automation@localhost -c user.name=devcontainer commit -m 'chore: initialize dev environment' --no-gpg-sign; fi \
 && git rev-parse HEAD > /var/lib/devcontainer_base_ref \
 && git reflog expire --expire=now --all && git gc --prune=now
WORKDIR /repo/beads

# 7. Resolve and compile this commit's complete unit-test tree.
RUN go mod download > /tmp/deps.log 2>&1 \
    && go build ./... >> /tmp/deps.log 2>&1 \
    && go test -count=1 -run '^$' ./... >> /tmp/deps.log 2>&1 \
    || { tail -50 /tmp/deps.log >&2; exit 1; }
# Unlocked pins: none.

# 8. Run tests as a non-root user.
# Several tests inject failures via `os.Chmod(path, 0555)` and expect the
# subsequent write (e.g. a git lockfile) to fail. root bypasses file-permission
# bits, so those writes succeed and the tests fail. Execute the suite as an
# unprivileged user so permission denials are real. The repo and Go caches are
# chowned so offline `go test` can compile; safe.directory '*' lets this user
# run git in the root-created repo (and keeps the external `git status` clean).
RUN useradd --create-home --uid 1000 tester \
 && chmod 755 /root \
 && chown -R tester:tester /repo /opt/cache /root/go \
 && git config --system --add safe.directory '*'
USER tester

# 9. No services to seed.
