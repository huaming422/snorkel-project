+// in aux_row_rekey_drifted (#4380).
+func TestRekeyAuxRowIDsRetriesDriftedAfterMarkerRecorded(t *testing.T) {
+	db, mock, err := sqlmock.New()
+	if err != nil {
+		t.Fatalf("sqlmock.New: %v", err)
+	}
+	defer db.Close()
+
+	expectCursorProbe(mock, "ignored_schema_migrations", true)
+	expectScalar(mock, "SELECT COALESCE(MAX(version), 0) FROM ignored_schema_migrations",
+		"version", auxRekeyPassInitial.markerVersion)
+	expectIgnoredSentinelProbes(mock, true)
+	expectAuxRekeyDrift(mock, "comments")
+
+	// rekeyAuxRowDriftedTables -> rekeyAuxRowTables snapshots drift again
+	expectAuxRekeyDrift(mock, "comments")
+	expectColumnExists(mock, true)
+	expectCommentsSelect(mock).
+		WillReturnRows(sqlmock.NewRows([]string{"id", "issue_id", "author", "text", "created_at"}).
+			AddRow(rowid.New("comments", 0, commentDigest("bd-1", "steve", "first", "2026-06-09 12:00:00")),
+				"bd-1", "steve", "first", "2026-06-09 12:00:00"))
+	// already holding target id -> no UPDATE; clear drift entry
+	expectAuxRekeyDrift(mock, "comments") // clearAuxRekeyDriftedTable loads
+	expectStoreAuxRekeyDrift(mock, "")
+
+	wrote, err := rekeyAuxRowIDs(context.Background(), db, auxRekeyPassInitial.shippedMainVersion, auxRekeyPassInitial)
+	if err != nil {
+		t.Fatalf("rekeyAuxRowIDs: %v", err)
+	}
+	if wrote {
+		t.Error("expected wrote=false when the drifted table was already converged")
+	}
+	if err := mock.ExpectationsWereMet(); err != nil {
+		t.Fatalf("unmet sql expectations: %v", err)
+	}
+}
+
+func TestParseAuxRekeyDriftedValue(t *testing.T) {
+	got := parseAuxRekeyDriftedValue(" comments,events, comments ")
+	want := []string{"comments", "events"}
+	if len(got) != len(want) || got[0] != want[0] || got[1] != want[1] {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	if parseAuxRekeyDriftedValue("") != nil {
+		t.Fatal("empty should be nil")
+	}
+}
