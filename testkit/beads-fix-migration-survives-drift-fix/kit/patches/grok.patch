+// loadAuxRekeyDrifted returns the aux tables previously skipped for dolt#11131
+// encoding drift. A missing local_metadata table or key means nothing is
+// pending retry.
+func loadAuxRekeyDrifted(ctx context.Context, db DBConn) ([]string, error) {
+	var tableCount int
+	if err := db.QueryRowContext(ctx,
+		`SELECT COUNT(*) FROM INFORMATION_SCHEMA.TABLES
+		 WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'local_metadata'`,
+	).Scan(&tableCount); err != nil {
+		return nil, err
+	}
+	if tableCount == 0 {
+		return nil, nil
+	}
+	var value sql.NullString
+	err := db.QueryRowContext(ctx,
+		"SELECT value FROM local_metadata WHERE `key` = ?",
+		auxRekeyDriftedKey).Scan(&value)
+	if errors.Is(err, sql.ErrNoRows) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	return parseAuxRekeyDriftedValue(value.String), nil
+}
+
+func parseAuxRekeyDriftedValue(value string) []string {
+	if strings.TrimSpace(value) == "" {
+		return nil
+	}
+	parts := strings.Split(value, ",")
+	out := make([]string, 0, len(parts))
+	seen := make(map[string]bool, len(parts))
+	for _, p := range parts {
+		name := strings.TrimSpace(p)
+		if name == "" || seen[name] {
+			continue
+		}
+		seen[name] = true
+		out = append(out, name)
+	}
+	sort.Strings(out)
+	return out
+}
+
+func storeAuxRekeyDrifted(ctx context.Context, db DBConn, tables []string) error {
+	if _, err := db.ExecContext(ctx, "CREATE TABLE IF NOT EXISTS local_metadata (`key` VARCHAR(255) PRIMARY KEY, value TEXT NOT NULL DEFAULT '')"); err != nil {
+		return fmt.Errorf("ensuring local_metadata: %w", err)
+	}
+	tables = parseAuxRekeyDriftedValue(strings.Join(tables, ","))
+	if len(tables) == 0 {
+		_, err := db.ExecContext(ctx,
+			"DELETE FROM local_metadata WHERE `key` = ?",
+			auxRekeyDriftedKey)
+		return err
+	}
+	_, err := db.ExecContext(ctx,
+		"REPLACE INTO local_metadata (`key`, value) VALUES (?, ?)",
+		auxRekeyDriftedKey, strings.Join(tables, ","))
+	return err
+}
+
+func recordAuxRekeyDrifted(ctx context.Context, db DBConn, table string) error {
+	existing, err := loadAuxRekeyDrifted(ctx, db)
+	if err != nil {
+		return err
+	}
+	return storeAuxRekeyDrifted(ctx, db, append(existing, table))
+}
+
+func clearAuxRekeyDriftedTable(ctx context.Context, db DBConn, table string) error {
+	existing, err := loadAuxRekeyDrifted(ctx, db)
+	if err != nil {
+		return err
+	}
+	if len(existing) == 0 {
+		return nil
+	}
+	next := existing[:0]
+	found := false
+	for _, name := range existing {
+		if name == table {
+			found = true
+			continue
+		}
+		next = append(next, name)
+	}
+	if !found {
+		return nil
+	}
+	return storeAuxRekeyDrifted(ctx, db, next)
+}
