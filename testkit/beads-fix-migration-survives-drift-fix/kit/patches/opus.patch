+// rekeyAuxRowTable re-derives the ids of one table, recovering from the
+// dolt#11131 encoding-drift panic. On that panic it returns
+// errAuxRowEncodingDrift so the caller can skip the drifted table instead of
+// crashing the whole migration pass (and the database open with it). The
+// recover is scoped to a single table so a drift in one table never hides a
+// genuine panic in another.
+func rekeyAuxRowTable(ctx context.Context, db DBConn, t auxRekeyTable) (wrote bool, err error) {
+	defer func() {
+		if r := recover(); r != nil {
+			if isAuxRowEncodingDrift(r) {
+				wrote = false
+				err = fmt.Errorf("%w: %v", errAuxRowEncodingDrift, r)
+				return
+			}
