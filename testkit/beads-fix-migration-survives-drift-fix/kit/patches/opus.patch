+package schema
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"testing"
+
+	"github.com/DATA-DOG/go-sqlmock"
+)
+
+// panicOnQueryDBConn forwards every call to an embedded DBConn except that,
+// when the next query/exec whose text contains trigger runs, it panics with
+// the dolt#11131 drift message instead of touching the database. It
+// reproduces the storage-engine panic that the re-key must survive: a read or
+// write against a table whose on-disk encoding has drifted beyond what the
+// engine can decode.
+type panicOnQueryDBConn struct {
+	inner      DBConn
+	trigger    string
+	panicQuery bool // panic on QueryContext (the SELECT) when true
+	panicExec  bool // panic on ExecContext (the UPDATE) when true
+}
+
+const driftPanicMsg = "runtime error: invalid hash length"
+
+func (d panicOnQueryDBConn) ExecContext(ctx context.Context, query string, args ...any) (sql.Result, error) {
+	if d.panicExec && containsSubstr(query, d.trigger) {
+		panic(driftPanicMsg)
+	}
+	return d.inner.ExecContext(ctx, query, args...)
+}
+
+func (d panicOnQueryDBConn) QueryContext(ctx context.Context, query string, args ...any) (*sql.Rows, error) {
+	if d.panicQuery && containsSubstr(query, d.trigger) {
+		panic(driftPanicMsg)
+	}
+	return d.inner.QueryContext(ctx, query, args...)
+}
+
+func (d panicOnQueryDBConn) QueryRowContext(ctx context.Context, query string, args ...any) *sql.Row {
+	return d.inner.QueryRowContext(ctx, query, args...)
+}
+
+func containsSubstr(s, sub string) bool {
+	return len(sub) == 0 || (len(s) >= len(sub) && indexOf(s, sub) >= 0)
+}
+
+func indexOf(s, sub string) int {
+	for i := 0; i+len(sub) <= len(s); i++ {
+		if s[i:i+len(sub)] == sub {
+			return i
+		}
+	}
+	return -1
+}
+
+// TestRekeyAuxRowTableRecoversSelectDrift reproduces #4380: reading a drifted
+// table panics deep in the storage engine with "invalid hash length". The
+// re-key must recover that panic and report errAuxRowEncodingDrift so the
+// caller can skip the table instead of letting the panic abort the migration
+// (and the database open).
+func TestRekeyAuxRowTableRecoversSelectDrift(t *testing.T) {
+	db, mock, err := sqlmock.New()
+	if err != nil {
+		t.Fatalf("sqlmock.New: %v", err)
+	}
+	defer db.Close()
+
+	expectColumnExists(mock, true)
+
+	conn := panicOnQueryDBConn{inner: db, trigger: "FROM comments", panicQuery: true}
+
+	wrote, err := rekeyAuxRowTable(context.Background(), conn, commentsTable)
+	if !errors.Is(err, errAuxRowEncodingDrift) {
+		t.Fatalf("expected errAuxRowEncodingDrift, got wrote=%v err=%v", wrote, err)
+	}
+	if wrote {
+		t.Fatalf("drifted table must report no writes, got wrote=%v", wrote)
+	}
+}
+
+// TestRekeyAuxRowTableRecoversUpdateDrift covers the write side: the SELECT
+// succeeds but the UPDATE panics with the drift message. The same recovery
+// must apply.
+func TestRekeyAuxRowTableRecoversUpdateDrift(t *testing.T) {
+	db, mock, err := sqlmock.New()
+	if err != nil {
+		t.Fatalf("sqlmock.New: %v", err)
+	}
+	defer db.Close()
+
+	expectColumnExists(mock, true)
+	expectCommentsSelect(mock).
+		WillReturnRows(sqlmock.NewRows([]string{"id", "issue_id", "author", "text", "created_at"}).
+			AddRow("random-a", "bd-1", "steve", "first", "2026-06-09 12:00:00"))
+
+	conn := panicOnQueryDBConn{inner: db, trigger: "UPDATE comments", panicExec: true}
+
+	wrote, err := rekeyAuxRowTable(context.Background(), conn, commentsTable)
+	if !errors.Is(err, errAuxRowEncodingDrift) {
+		t.Fatalf("expected errAuxRowEncodingDrift, got wrote=%v err=%v", wrote, err)
+	}
+}
+
+// TestRekeyAuxRowTableRepanicsUnknownPanic guards the recover's scope: a panic
+// that is NOT the drift we know how to survive must propagate, not be silently
+// swallowed.
+func TestRekeyAuxRowTableRepanicsUnknownPanic(t *testing.T) {
+	db, mock, err := sqlmock.New()
+	if err != nil {
+		t.Fatalf("sqlmock.New: %v", err)
+	}
+	defer db.Close()
+
+	expectColumnExists(mock, true)
+
+	conn := panicOnQueryDBConnCustom{inner: db, trigger: "FROM comments", msg: "some other fatal bug"}
+
+	defer func() {
+		r := recover()
+		if r == nil {
+			t.Fatalf("expected the non-drift panic to propagate, but it was swallowed")
+		}
+	}()
+	_, _ = rekeyAuxRowTable(context.Background(), conn, commentsTable)
+}
+
+type panicOnQueryDBConnCustom struct {
+	inner   DBConn
+	trigger string
+	msg     string
+}
+
+func (d panicOnQueryDBConnCustom) ExecContext(ctx context.Context, query string, args ...any) (sql.Result, error) {
+	return d.inner.ExecContext(ctx, query, args...)
+}
+
+func (d panicOnQueryDBConnCustom) QueryContext(ctx context.Context, query string, args ...any) (*sql.Rows, error) {
+	if containsSubstr(query, d.trigger) {
+		panic(d.msg)
+	}
+	return d.inner.QueryContext(ctx, query, args...)
+}
+
+func (d panicOnQueryDBConnCustom) QueryRowContext(ctx context.Context, query string, args ...any) *sql.Row {
+	return d.inner.QueryRowContext(ctx, query, args...)
+}
+
+// TestRekeyAuxRowIDsPendingSkipsDriftedTable is the loop-level #4380
+// regression: when one table drifts (dolt#11131), the pass skips it with a
+// warning and returns no error \u2014 the migration completes and the database
+// opens \u2014 while the remaining tables are still processed and the in-progress
+// sentinel is left set so a later pass resumes the skipped table.
+func TestRekeyAuxRowIDsPendingSkipsDriftedTable(t *testing.T) {
+	db2, mock2, err := sqlmock.New()
+	if err != nil {
+		t.Fatalf("sqlmock.New: %v", err)
+	}
+	defer db2.Close()
+
+	// auxRekeyResumePending: local_metadata table absent -> COUNT 0.
+	mock2.ExpectQuery(`SELECT COUNT\(\*\) FROM INFORMATION_SCHEMA\.TABLES`).
+		WillReturnRows(sqlmock.NewRows([]string{"c"}).AddRow(0))
+
+	// setAuxRekeyInProgress: CREATE TABLE IF NOT EXISTS + REPLACE INTO.
+	mock2.ExpectExec(`CREATE TABLE IF NOT EXISTS local_metadata`).
+		WillReturnResult(sqlmock.NewResult(0, 0))
+	mock2.ExpectExec(`REPLACE INTO local_metadata`).
+		WillReturnResult(sqlmock.NewResult(0, 1))
+
+	// Table loop. Order: events, comments, issue_snapshots, compaction_snapshots.
+	// events: column probe -> absent -> skip cleanly.
+	expectColumnExists(mock2, false)
+	// comments: column probe -> present, then the SELECT panics (drift).
+	expectColumnExists(mock2, true)
+	// (the comments SELECT is intercepted by the panic wrapper, never reaches mock2)
+	// issue_snapshots: absent -> skip.
+	expectColumnExists(mock2, false)
+	// compaction_snapshots: absent -> skip.
+	expectColumnExists(mock2, false)
+
+	conn := panicOnQueryDBConn{inner: db2, trigger: "FROM comments", panicQuery: true}
+
+	// markerVersion 9 is pending; mainVersionBefore below the watershed.
+	pending := []int{auxRekeyPassInitial.markerVersion}
+	wrote, err := rekeyAuxRowIDsPending(context.Background(), conn,
+		auxRekeyPassInitial.shippedMainVersion-1, auxRekeyPassInitial, pending)
+	if err != nil {
+		t.Fatalf("drifted table must not abort the pass, got err=%v", err)
+	}
+	if wrote {
+		t.Fatalf("no table should have been rewritten (all skipped/drifted), got wrote=%v", wrote)
+	}
+	if err := mock2.ExpectationsWereMet(); err != nil {
+		t.Fatalf("unmet expectations: %v", err)
+	}
+}
