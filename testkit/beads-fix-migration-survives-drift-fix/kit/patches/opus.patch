+// errAuxRowEncodingDrift marks a table that could not be re-keyed because its
+// on-disk history/comments encoding has drifted in a way the storage engine
+// cannot decode (dolt#11131): reading or writing a row panics deep in the
+// engine with "invalid hash length". Rather than let that panic abort the
+// whole migration pass — which left the database unopenable on every start,
+// with no forward or backward path (#4380) — the re-key recovers it, skips the
+// drifted table with a warning, records the skip clone-locally, and relies on
+// a later convergence pass to retry it once the drift is gone.
+var errAuxRowEncodingDrift = errors.New("aux row encoding drift (dolt#11131)")
+
+// auxRowEncodingDriftMarker is the dolt-engine panic string emitted when a
+// table's row encoding has drifted beyond what it can decode. It is matched as
+// a substring because the engine wraps it with positional context.
+const auxRowEncodingDriftMarker = "invalid hash length"
+
+// isAuxRowEncodingDrift reports whether a recovered panic value is the
+// dolt#11131 encoding-drift panic (as opposed to any other, genuinely fatal
+// bug we must not swallow).
+func isAuxRowEncodingDrift(r any) bool {
+	if r == nil {
+		return false
+	}
+	var msg string
+	switch v := r.(type) {
+	case error:
+		msg = v.Error()
+	case string:
+		msg = v
+	default:
+		msg = fmt.Sprintf("%v", v)
+	}
+	return strings.Contains(msg, auxRowEncodingDriftMarker)
+}
