@@ -0,0 +1,39 @@
+package schema
+
+import (
+	"context"
+	"regexp"
+	"testing"
+
+	"github.com/DATA-DOG/go-sqlmock"
+)
+
+func TestStageSchemaTablesForceStagesRequestedDirtyTable(t *testing.T) {
+	db, mock, err := sqlmock.New()
+	if err != nil {
+		t.Fatalf("sqlmock.New: %v", err)
+	}
+	defer db.Close()
+
+	mock.ExpectQuery("(?s)SELECT s\\.table_name, s\\.staged\\s+FROM dolt_status s").
+		WillReturnRows(sqlmock.NewRows([]string{"table_name", "staged"}).AddRow("comments", false))
+	mock.ExpectQuery(`SELECT t\.TABLE_NAME\s+FROM INFORMATION_SCHEMA\.TABLES t`).
+		WillReturnRows(sqlmock.NewRows([]string{"TABLE_NAME"}).AddRow("comments"))
+	mock.ExpectQuery(regexp.QuoteMeta("CALL DOLT_ADD('-f', ?)")).
+		WithArgs("comments").
+		WillReturnRows(sqlmock.NewRows([]string{"status"}))
+
+	staged, err := stageSchemaTables(context.Background(), db,
+		map[string]dirtyTableState{"comments": {staged: false}},
+		map[string]struct{}{"comments": {}},
+	)
+	if err != nil {
+		t.Fatalf("stageSchemaTables: %v", err)
+	}
+	if !staged {
+		t.Fatal("expected staged=true when forceStage names a pre-existing dirty table")
+	}
+	if err := mock.ExpectationsWereMet(); err != nil {
+		t.Fatalf("unmet sql expectations: %v", err)
+	}
+}
