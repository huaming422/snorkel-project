+func TestIsInvalidHashLength(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name string
+		err  error
+		want bool
+	}{
+		{name: "nil"},
+		{name: "plain", err: errors.New("invalid hash length: 19"), want: true},
+		{name: "wrapped mysql panic text", err: fmt.Errorf("read rows: %w", &mysql.MySQLError{Number: 1105, Message: "panic: invalid hash length: 1"}), want: true},
+		{name: "case-insensitive", err: errors.New("INVALID HASH LENGTH: 7"), want: true},
+		{name: "unrelated", err: errors.New("duplicate entry")},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			if got := IsInvalidHashLength(tc.err); got != tc.want {
+				t.Fatalf("IsInvalidHashLength(%v) = %v, want %v", tc.err, got, tc.want)
+			}
+		})
+	}
+}
