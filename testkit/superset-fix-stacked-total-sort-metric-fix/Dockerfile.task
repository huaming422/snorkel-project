# Pre-fix commit: 347774f9b82842ca696f5b128a150e21a32da57d
# Source PR: https://github.com/apache/superset/pull/42881

FROM ubuntu:22.04
# Pipes inside RUN fail loudly: without pipefail a failing `curl` before `| tar`
# or `| sh` is invisible and the image "builds" without the tool.
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_INPUT=1

# Test runners size worker pools from the visible CPU count, so peak memory
# scales with the host, not with the task's declared resources. Cap the runner
# pools to the task.toml cpus (4) so the declared memory bound holds on any
# host. Only runner-pool knobs live here: MAKEFLAGS is inherited by every nested
# make (node-gyp native builds broke under it), so it is never set; test.sh sizes
# make/cmake/cargo build jobs from the cgroup memory at grade time. turbo x vitest
# nest, so their product (not each) equals cpus.
ENV TURBO_CONCURRENCY=2 \
    VITEST_MAX_THREADS=2 \
    VITEST_MIN_THREADS=1 \
    GOMAXPROCS=4 \
    CARGO_BUILD_JOBS=4 \
    RUST_TEST_THREADS=4 \
    PYTEST_XDIST_AUTO_NUM_WORKERS=4 \
    CMAKE_BUILD_PARALLEL_LEVEL=4

# System packages. This task exercises only the React/TypeScript frontend
# (plugin-chart-echarts) via jest, so the toolchain is Node + git. The verifier
# runtime lives in the isolated /opt/tooling venv (uv-managed Python), so no
# system pip is installed here.
RUN apt-get update && apt-get install -y --no-install-recommends \
        bash ca-certificates curl git wget jq \
        python3 \
        build-essential \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Canonical verifier runtime. Insert after apt/system packages and
# before the repository language toolchain so same-repo images share the layer.
# The pins are src/resources/verifier-requirements.txt inlined. BUILD_DATE
# freezes their transitive resolution (UV_EXCLUDE_NEWER, this install only); it
# may move forward per image but never before the newest pin's release. uv
# counts the whole named day, so use a day that has already ended. The ARG may
# instead sit with the image's other ARGs at the top of the final stage.
ARG BUILD_DATE=2026-09-24
RUN curl -LsSf https://astral.sh/uv/0.11.26/install.sh | env UV_INSTALL_DIR=/opt/tooling/uv UV_NO_MODIFY_PATH=1 sh \
 && export UV_PYTHON_INSTALL_DIR=/opt/tooling/python UV_NO_CACHE=1 \
 && /opt/tooling/uv/uv python install 3.12 \
 && /opt/tooling/uv/uv venv --managed-python --python 3.12 /opt/tooling/venv \
 && UV_EXCLUDE_NEWER=${BUILD_DATE} /opt/tooling/uv/uv pip install --python /opt/tooling/venv/bin/python \
    pytest==9.1.1 requests==2.34.2 jinja2==3.1.6 litellm==1.93.0 pydantic==2.13.4 \
    unidiff==0.7.5 pygments==2.20.0 ast-grep-py==0.44.1 mini-swe-agent==2.4.5 portkey-ai==2.3.3 \
 && LITELLM_LOCAL_MODEL_COST_MAP=True /opt/tooling/venv/bin/python -c "import ast_grep_py, jinja2, litellm, minisweagent, portkey_ai, pydantic, pygments, pytest, requests, unidiff"

# Node.js — the exact version the repo pins (superset-frontend/.nvmrc is
# v24.16.0; package.json engines wants node ^24.16.0 and npm ^11.13.0).
# Downloaded per-architecture from nodejs.org with the SHASUMS256 check so both
# `node` and `npm` are present regardless of apt-repo availability; the tarball
# extracts to /usr/local/bin/{node,npm,npx,...}. npm is then pinned to the
# engines floor (nodesource's floating npm 11.19 broke superset's lockfile
# check).
RUN NODE_VERSION_PIN="24.16.0" \
    && ARCH="$(dpkg --print-architecture)" && case "$ARCH" in \
         amd64) NODE_ARCH=x64;; arm64) NODE_ARCH=arm64;; \
         *) echo "unsupported arch: $ARCH" >&2; exit 1;; esac \
    && NODE_TGZ="node-v${NODE_VERSION_PIN}-linux-${NODE_ARCH}.tar.xz" \
    && curl -fsSL -o "/tmp/${NODE_TGZ}" "https://nodejs.org/dist/v${NODE_VERSION_PIN}/${NODE_TGZ}" \
    && curl -fsSL -o /tmp/SHASUMS256.txt "https://nodejs.org/dist/v${NODE_VERSION_PIN}/SHASUMS256.txt" \
    && (cd /tmp && grep " ${NODE_TGZ}$" SHASUMS256.txt | sha256sum -c -) \
    && tar -xJf "/tmp/${NODE_TGZ}" -C /usr/local --strip-components=1 --no-same-owner \
    && rm -f "/tmp/${NODE_TGZ}" /tmp/SHASUMS256.txt \
    && npm install -g npm@11.13.0 \
    && node --version && npm --version

# Bake /usr/local/bin into PATH so npm/npx are always reachable in any shell
# context (login or non-login, su or direct exec).
ENV PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Keep the npm cache at a stable, root-visible location so the build-time warm
# is the same cache the offline agent/verifier phases read (HOME=/root).
ENV npm_config_cache=/opt/npm-cache

# Clone → fetch the pinned commit → rewind → scrub → bake the frontend
# dependency closure → baseline-commit in ONE layer. Every one of these steps
# rewrites the repo's .git object store and/or working tree; split across
# separate RUN instructions, each rewrite ships as its own multi-GB image layer.
# The agent phase is offline (agent_offline=true), so node_modules + the npm
# cache must be warm here — the dependency closure cannot be fetched later.
RUN git clone --depth=1 --single-branch --no-tags -b master \
        https://github.com/apache/superset.git /repo/superset && \
    cd /repo/superset && \
    git fetch --depth=1000 origin 347774f9b82842ca696f5b128a150e21a32da57d && \
    git reset --hard 347774f9b82842ca696f5b128a150e21a32da57d && \
    git remote remove origin && rm -rf .git/refs/remotes && \
    rm -f .git/FETCH_HEAD .git/ORIG_HEAD && \
    git reflog expire --expire=now --all && \
    git gc --prune=now && \
    ( cd /repo/superset/superset-frontend && \
      npm install --no-audit --no-fund --legacy-peer-deps > /tmp/npm-bake.log 2>&1 \
        || { tail -80 /tmp/npm-bake.log; exit 1; } ) && \
    git add -A && \
    if ! git diff --cached --quiet; then \
        git -c user.email=automation@localhost -c user.name=devcontainer \
            commit -m 'chore: initialize dev environment' --no-gpg-sign; \
    fi && \
    git rev-parse HEAD > /var/lib/devcontainer_base_ref
WORKDIR /repo/superset
