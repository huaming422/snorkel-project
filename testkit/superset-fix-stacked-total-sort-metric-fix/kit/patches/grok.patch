+  test('stacked totals exclude sort-only extra metrics not displayed as bars', () => {
+    // When x-axis is sorted by a metric that is not one of the displayed metrics,
+    // that sort metric is fetched as an "extra" column. Bar totals must still
+    // equal the sum of the stacked segments that are actually rendered.
+    const sortOnlyFormData: SqlaFormData = {
+      viz_type: 'echarts_timeseries_bar',
+      colorScheme: 'bnbColors',
+      datasource: '3__table',
+      granularity_sqla: 'ds',
+      metrics: ['sales', 'profit'],
+      groupby: [],
+      x_axis: 'category',
+      x_axis_sort: 'sort_metric',
+      timeseries_limit_metric: 'sort_metric',
+      showValue: true,
+      stack: true,
+      onlyTotal: true,
+      percentageThreshold: 0,
+      seriesType: EchartsTimeseriesSeriesType.Bar,
+    };
+
+    const sortOnlyQueriesData: ChartDataResponseResult[] = [
+      createTestQueryData([
+        { category: 'A', sales: 10, profit: 5, sort_metric: 100 },
+        { category: 'B', sales: 20, profit: 8, sort_metric: 50 },
+        { category: 'C', sales: 3, profit: 1, sort_metric: 7 },
+      ]),
+    ];
+
+    const chartProps = createTestChartProps({
+      formData: sortOnlyFormData,
+      queriesData: sortOnlyQueriesData,
+    });
+
+    const transformedSeries = transformProps(chartProps).echartOptions
+      .series as seriesType[];
+
+    // Only sales and profit should be rendered — not sort_metric.
+    const seriesNames = transformedSeries.map(s => s.name).sort();
+    expect(seriesNames).toEqual(['profit', 'sales']);
+
+    // Expected totals = sales + profit per category (excluding sort_metric)
+    const expectedTotals = [15, 28, 4];
+
+    const showValueIndexes: number[] = [];
+    transformedSeries.forEach((entry, seriesIndex) => {
+      const { data = [] } = entry;
+      (data as [Date, number][]).forEach((datum, dataIndex) => {
+        if (datum[1] !== null) {
+          showValueIndexes[dataIndex] = seriesIndex;
+        }
+      });
+    });
+
+    transformedSeries.forEach((series, seriesIndex) => {
+      series.data.forEach((value, dataIndex) => {
+        const params = {
+          value,
+          dataIndex,
+          seriesIndex,
+        };
+        const expectedLabel =
+          seriesIndex === showValueIndexes[dataIndex]
+            ? String(expectedTotals[dataIndex])
+            : '';
+        expect(series.label.formatter(params)).toBe(expectedLabel);
+      });
+    });
+  });
 });
 
