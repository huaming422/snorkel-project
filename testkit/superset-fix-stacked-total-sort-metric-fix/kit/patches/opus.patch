+
+describe('extractDataTotalValues', () => {
+  const data = [
+    { __timestamp: '2000-01-01', Hulk: 2, abc: 3, sortMetric: 100 },
+    { __timestamp: '2000-02-01', Hulk: 2, abc: 10, sortMetric: 200 },
+    { __timestamp: '2000-03-01', Hulk: 1, abc: 5, sortMetric: 300 },
+  ];
+
+  test('sums all non-xAxis columns when no extra metrics are provided', () => {
+    // NOTE: without excluding the extra sort metric the totals are inflated.
+    const { totalStackedValues } = extractDataTotalValues(data, {
+      stack: true,
+      percentageThreshold: 0,
+      xAxisCol: '__timestamp',
+    });
+    expect(totalStackedValues).toEqual([105, 212, 306]);
+  });
+
+  test('excludes extra metric labels (e.g. an x-axis sort metric not shown as a bar)', () => {
+    const { totalStackedValues } = extractDataTotalValues(data, {
+      stack: true,
+      percentageThreshold: 0,
+      xAxisCol: '__timestamp',
+      extraMetricLabels: ['sortMetric'],
+    });
+    // Totals should match the sum of the stacked segments only.
+    expect(totalStackedValues).toEqual([5, 12, 6]);
+  });
+
+  test('respects legendState together with extraMetricLabels', () => {
+    const { totalStackedValues } = extractDataTotalValues(data, {
+      stack: true,
+      percentageThreshold: 0,
+      xAxisCol: '__timestamp',
+      extraMetricLabels: ['sortMetric'],
+      legendState: { Hulk: true, abc: false },
+    });
+    expect(totalStackedValues).toEqual([2, 2, 1]);
+  });
+
+  test('returns empty arrays when not stacked', () => {
+    const { totalStackedValues, thresholdValues } = extractDataTotalValues(
+      data,
+      {
+        stack: false,
+        percentageThreshold: 0,
+        xAxisCol: '__timestamp',
+        extraMetricLabels: ['sortMetric'],
+      },
+    );
+    expect(totalStackedValues).toEqual([]);
+    expect(thresholdValues).toEqual([]);
+  });
+});
